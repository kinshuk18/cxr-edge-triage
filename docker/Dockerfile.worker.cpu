# CPU-only worker image used by docker compose and local smoke tests.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin worker
WORKDIR /app
COPY requirements.api.txt requirements.worker.txt ./
RUN python -m pip install --no-cache-dir torch==2.4.1 torchvision==0.19.1 --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir -r requirements.worker.txt
COPY app /app/app
COPY worker /app/worker
COPY schemas /app/schemas
USER 10001:10001
CMD ["python", "-m", "worker.main"]
